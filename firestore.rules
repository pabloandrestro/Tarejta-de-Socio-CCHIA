rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Reglas para usuarios (users/{uid})
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) &&
        request.resource.data.email is string &&
        request.resource.data.rol in ['socio', 'admin'] &&
        (request.resource.data.rol != 'admin' || isAdmin());
      allow update: if (
        (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'aceptoPrivacidad', 'aceptoConfidencialidad'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Reglas para tarjetas (cards/{cardId})
    match /cards/{cardId} {
      // Público puede leer si está Publicada; socio lee la suya; admin lee todas
      allow get: if resource.data.estado == 'Publicada' ||
                    (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
                    isAdmin();

      allow list: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
                     resource.data.estado == 'Publicada' ||
                     isAdmin();

      // Creación por el socio dueño
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.titulo is string &&
        request.resource.data.titulo.size() <= 80 &&
        request.resource.data.descripcion is string &&
        request.resource.data.descripcion.size() <= 300 &&
        request.resource.data.estado in ['Borrador', 'En revisión'];

      // Edición
      allow update: if (
        isAdmin() ||
        (
          isSignedIn() &&
          resource.data.ownerUid == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          // El socio no puede autopublicar si no estaba publicada
          (
            (resource.data.estado == 'Publicada' && request.resource.data.estado == 'Publicada') ||
            (resource.data.estado in ['Borrador', 'En revisión'] && request.resource.data.estado in ['Borrador', 'En revisión'])
          )
        )
      );

      // Eliminación: Admin o dueño si está en Borrador
      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid && resource.data.estado == 'Borrador');
    }
  }
}
