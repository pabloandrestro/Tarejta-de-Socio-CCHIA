# Configuración de Firebase (Frontend - Vite)
# Obtenida en Firebase Console > Configuración del proyecto > Apps web
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Clave de Gemini para el servidor / Cloudflare Worker (Secret)
# En Cloudflare Workers: configurar como secreto con 'npx wrangler secret put GEMINI_API_KEY'
# En desarrollo local: configurar en archivo .env
GEMINI_API_KEY=""

# URL canónica de la aplicación (opcional)
APP_URL="https://directorio.cchia.cl"
