rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /logos/{userId}/{fileName} {
      // Lectura pública de logos para el directorio
      allow read: if true;
      
      // Escritura solo por el socio dueño de la carpeta o admin
      // Tamaño máximo: 5MB, tipo de imagen válido (jpeg, png, webp)
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      
      allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
    }
  }
}
